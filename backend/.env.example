DATABASE_URL=sqlite:///./dealpilot.db
FRONTEND_URL=http://localhost:3000
# Generate a random token of at least 32 characters. Do not put it in frontend env.
WORKSPACE_TOKEN=

# Google Gemini Configuration (Recommended - supports gemini-4-argon, gemini-3.8-flash, etc.)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon

# OpenAI Configuration (Alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# PayPal Sandbox Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
